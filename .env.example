# Memoria.ia Enterprise product-alpha
# Copy to .env and replace placeholders. Never commit real secrets.

MEMORIA_ORGANIZATION_ID=org-example
MEMORIA_ORGANIZATION_NAME=Example Organization
MEMORIA_NODE_ID=memoria:org-example:primary
MEMORIA_API_KEY=replace-with-a-long-random-secret
MEMORIA_DATA_DIR=/data

# Production conversation/episodic runtime.
# Native is the v1 production default and fails closed if MEMORIA_NATIVE_LIB is missing.
# Set BOTH values to python only for explicit reference/testing of the legacy Python path.
MEMORIA_CONVERSATION_RUNTIME=native
MEMORIA_EPISODIC_RUNTIME=native
# Docker image default. For a source/local deployment, point this to the built
# libmemoria_mobile shared library for the current platform.
MEMORIA_NATIVE_LIB=/usr/local/lib/libmemoria_mobile.so

# LLM provider is optional. Leave blank for memory-only mode.
# Supported in product-alpha: mock, openai, gemini
MEMORIA_LLM_PROVIDER=mock
# Required for external providers (openai/gemini).
MEMORIA_LLM_MODEL=

# OpenAI (only when MEMORIA_LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Gemini (only when MEMORIA_LLM_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Optional pricing inputs for estimated request cost. Leave blank rather than
# hard-coding provider prices; configure current USD per 1M tokens explicitly.
MEMORIA_LLM_INPUT_USD_PER_MILLION=
MEMORIA_LLM_OUTPUT_USD_PER_MILLION=

# Node identity. Full certificate validation belongs to the external MA2A trust module.
MEMORIA_PUBLIC_KEY=
MEMORIA_CERTIFICATE_REF=
MEMORIA_CERTIFICATE_STATUS=not_configured
MEMORIA_CAPABILITIES=memory.read,memory.write

# License boundary. Early product-alpha installations may use EARLY_ACCESS at price 0.
# Memoria.ia consumes entitlement metadata; it does NOT issue its own commercial licenses.
# Cryptographic issuance/revocation will belong to the future external M2A license authority.
MEMORIA_LICENSE_STATUS=not_configured
MEMORIA_LICENSE_ID=
MEMORIA_LICENSE_PLAN=early_access
MEMORIA_LICENSE_VALID_UNTIL=
MEMORIA_LICENSE_MAX_NODES=1
MEMORIA_LICENSE_CAPABILITIES=memory.read,memory.write,chat.use
